# Lo lee vite.config.mjs para que el watcher de Vite use polling en vez de
# fs.watch nativo. En Windows, si se copia/descarga un archivo pesado (p. ej. un
# .mp4) dentro de public/ mientras el servidor corre, el archivo a medio escribir
# queda bloqueado y el watcher nativo se cae con EBUSY, tumbando el `npm run dev`.
# Con polling eso ya no ocurre. Contrapartida: un poco más de CPU. Si molesta,
# borra esta línea y simplemente no dejes descargas a medias en public/.
CHOKIDAR_USEPOLLING=true

# Chatbot: solo los lee la función de servidor /api/chat. Van en .env.local
# (local, con `vercel dev`) y en las variables de entorno de Vercel. Nunca con
# prefijo VITE_: esas variables quedan incrustadas en el bundle público.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: modelos de respaldo, separados por comas, si el principal falla o
# se cuelga. Sin definir usa gemini-3.1-flash-lite,gemini-3.6-flash; vacía
# (GEMINI_MODELOS_RESPALDO=) deja el chat sin respaldo.
# GEMINI_MODELOS_RESPALDO=gemini-3.1-flash-lite,gemini-3.6-flash
