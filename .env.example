# El watcher del servidor de desarrollo usa polling en vez de fs.watch nativo.
# En Windows, si se copia/descarga un .mp4 dentro de public/media/ mientras el
# servidor corre, el archivo a medio escribir queda bloqueado y fs.watch se cae
# con EBUSY, tumbando el `npm start`. Con polling eso ya no ocurre.
# Contrapartida: un poco más de CPU y HMR ligeramente más lento. Si molesta,
# borra esta línea y simplemente no dejes descargas a medias en public/media/.
CHOKIDAR_USEPOLLING=true
