# La CLI de Vercel no lee el .gitignore: sube todo salvo lo que diga este
# archivo. Lista blanca con solo lo que necesita el build de producción.
/*
!/src
!/public
!/api
!/index.html
!/vite.config.mjs
!/vercel.json
!/package.json
!/package-lock.json

# Videos fuente en alta calidad: no van al sitio publicado.
/public/media/fuente
